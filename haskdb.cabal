cabal-version:  2.4
name:           haskdb
version:        0.1.0
license:        NONE
author:         HaskDB project
-- GHC + boot libraries only in the library; see design/11 D-06 (network
-- package gets added in Phase 7 for the socket layer).
-- Build: cabal build ; language GHC2021 per internal-design/00 §0.7.
-- libgmp-dev is absent on this box: a libgmp.so symlink sits in the
-- ghcup toolchain lib dir so -lgmp resolves at link time.

library
    default-language:  GHC2021
    default-extensions: OverloadedStrings
    build-depends:    base, bytestring, containers, binary, array, text, mtl, stm, ghc-internal, unix, directory, filepath
    hs-source-dirs:   src
    exposed-modules:  HaskDB.Common.Types
                    , HaskDB.Common.Error
                    , HaskDB.Common.Codec
                    , HaskDB.Common.Config
                    , HaskDB.Storage.FileManager
                    , HaskDB.Storage.Page
                    , HaskDB.Storage.BufferPool
                    , HaskDB.Storage.FreeSpace
                    , HaskDB.Heap.TupleCodec
                    , HaskDB.Wal.Format
                    , HaskDB.Wal.Manager
                    , HaskDB.Server.Control
                    , HaskDB.Server.Env
                    , HaskDB.Wal.Apply
                    , HaskDB.Catalog.Types
                    , HaskDB.Catalog.Cache
                    , HaskDB.Catalog.Bootstrap
                    , HaskDB.Index.BTree
                    , HaskDB.Txn.LockManager
                    , HaskDB.Txn.Manager
                    , HaskDB.Txn.Deadlock
                    , HaskDB.Heap.Heap
                    , HaskDB.Wal.Recovery
                    , HaskDB.Sql.Lexer
                    , HaskDB.Sql.Ast
                    , HaskDB.Sql.Parser
                    , HaskDB.Sql.Analyzer
    ghc-options:      -Wall -optl-L/home/ryo/.local/lib

test-suite codec-tests
    type:               exitcode-stdio-1.0
    default-language:   GHC2021
    default-extensions: OverloadedStrings
    main-is:            Spec.hs
    build-depends:      base, bytestring, containers, binary, array, text, mtl, directory, haskdb
    hs-source-dirs:     test
    ghc-options:        -Wall -optl-L/home/ryo/.local/lib

test-suite storage-tests
    type:               exitcode-stdio-1.0
    default-language:   GHC2021
    default-extensions: OverloadedStrings
    main-is:            StorageSpec.hs
    build-depends:      base, bytestring, containers, binary, array, text, mtl, stm, directory, filepath, haskdb
    hs-source-dirs:     test
    ghc-options:        -Wall -optl-L/home/ryo/.local/lib

