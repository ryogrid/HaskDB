cabal-version:  2.4
name:           haskdb
version:        0.1.0
license:        NONE
author:         HaskDB project
-- GHC + boot libraries only; the Listener socket is a libc shim reached
--   through GHC's FFI (c-sources below).  D-06 chose the `network` package,
--   amended to D-24: network is not a boot library and cannot be built with
--   this toolchain (its Setup needs a statically linked hsc2hs, no static
--   gmp on this box).
-- Build: cabal build ; language GHC2021 per internal-design/00 §0.7.
-- libgmp-dev is absent on this box: a libgmp.so symlink sits in the
-- ghcup toolchain lib dir so -lgmp resolves at link time.

library
    default-language:  GHC2021
    default-extensions: OverloadedStrings
    other-extensions:   ForeignFunctionInterface
    c-sources:          c/hs-socket.c
    build-depends:    base, bytestring, containers, binary, array, text, mtl, stm, ghc-internal, unix, directory, filepath, time
    hs-source-dirs:   src
    exposed-modules:  HaskDB.Common.Types
                    , HaskDB.Common.Error
                    , HaskDB.Common.Codec
                    , HaskDB.Common.Config
                    , HaskDB.Storage.FileManager
                    , HaskDB.Storage.Page
                    , HaskDB.Storage.BufferPool
                    , HaskDB.Storage.FreeSpace
                    , HaskDB.Heap.TupleCodec
                    , HaskDB.Wal.Format
                    , HaskDB.Wal.Manager
                    , HaskDB.Server.Control
                    , HaskDB.Server.Env
                    , HaskDB.Wal.Apply
                    , HaskDB.Catalog.Types
                    , HaskDB.Catalog.Cache
                    , HaskDB.Catalog.Bootstrap
                    , HaskDB.Index.BTree
                    , HaskDB.Txn.LockManager
                    , HaskDB.Txn.Manager
                    , HaskDB.Txn.Deadlock
                    , HaskDB.Heap.Heap
                    , HaskDB.Wal.Recovery
                    , HaskDB.Sql.Lexer
                    , HaskDB.Sql.Ast
                    , HaskDB.Sql.Parser
                    , HaskDB.Sql.Analyzer
                    , HaskDB.Executor.Types
                    , HaskDB.Executor.MemoryBudget
                    , HaskDB.Executor.Eval
                    , HaskDB.Executor.Operators
                    , HaskDB.Executor.Stmts
                    , HaskDB.Planner.Planner
                    , HaskDB.Planner.CostModel
                    , HaskDB.Server.Wire
                    , HaskDB.Server.Session
                    , HaskDB.Server.Socket
                    , HaskDB.Server.Listener
    ghc-options:      -Wall -optl-L/home/ryo/.local/lib

-- | haskdb-server (§11.1): the server executable.
executable haskdb-server
    default-language:   GHC2021
    default-extensions: OverloadedStrings
    main-is:            Main.hs
    build-depends:      base, bytestring, text, containers, unix, directory,
                          filepath, time, haskdb
    hs-source-dirs:     app
    ghc-options:        -Wall -rtsopts -threaded
                          -with-rtsopts=-N2 -optl-L/home/ryo/.local/lib

